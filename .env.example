# -----------------------------------------------------------------------------
# Docker Compose settings for the local PostgreSQL container.
#
# Copy this file to `.env` (same folder as docker-compose.yml) and change the
# values. `.env` is git-ignored — never commit real credentials.
#
# These values are only applied when the data volume is created for the first
# time. Changing them later does NOT change the password of an existing
# database (see README → "Docker Compose usage").
# -----------------------------------------------------------------------------

POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=inventory

# Host port mapped to the container's 5432. Change it if 5432 is already in use.
POSTGRES_PORT=5432
