# -----------------------------------------------------------------------------
# Frontend environment variables (Vite).
# Copy to `apps/frontend/.env` (or `.env.local`) and adjust.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# They are PUBLIC — never put secrets here.
# -----------------------------------------------------------------------------

# Base URL of the NestJS REST API (including the /api prefix).
VITE_API_BASE_URL=http://localhost:3000/api
