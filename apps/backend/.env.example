# -----------------------------------------------------------------------------
# NestJS API environment variables.
# Copy to `apps/backend/.env` and adjust. `.env` is git-ignored.
# All variables are validated at startup (src/config/env.validation.ts).
# -----------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the API listens on. The API is served under http://localhost:PORT/api
PORT=3000

# Origin(s) allowed by CORS — the Vite dev server by default.
# Comma-separated list for several origins.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string used by the API and by the Prisma CLI.
# Must match the credentials/port in the root `.env` used by Docker Compose:
# postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:POSTGRES_PORT/POSTGRES_DB?schema=public
DATABASE_URL=postgresql://inventory:change-me-local-only@localhost:5432/inventory?schema=public
