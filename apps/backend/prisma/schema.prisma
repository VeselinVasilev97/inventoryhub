// =============================================================================
// Inventory Management System — database schema
//
// This file is the source of truth for the database structure.
// Every change MUST go through Prisma Migrate (see README → "Creating future
// migrations"). Never use `prisma db push` for this project.
//
// Conventions
// -----------
// * Models are PascalCase / fields camelCase in TypeScript, and are mapped to
//   snake_case tables and columns in PostgreSQL with @@map / @map.
// * Primary keys are UUIDs (version 7, time-ordered for better index locality),
//   generated by Prisma Client and stored in the native `uuid` column type.
// * Timestamps use `timestamptz(3)` (UTC, millisecond precision).
// * Money uses Decimal(19, 4). Never use floating point for money.
// * Quantities use Decimal(18, 3) so fractional units of measure (kg, l, m)
//   are supported. Discrete items (pcs) simply store whole numbers.
// * Historical data (stock movements, orders) is protected with
//   `onDelete: Restrict`. Deactivate records with `isActive` instead of
//   deleting them.
// * CHECK constraints (non-negative prices, positive quantities, ...) cannot
//   be expressed in Prisma Schema Language. They are written by hand in the
//   migration SQL — see prisma/migrations/*_init/migration.sql.
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The NestJS app is compiled to CommonJS (NestJS default), so the generated
  // client is emitted as CommonJS with extensionless relative imports, which
  // works for `nest build` (tsc) and for Jest (ts-jest).
  moduleFormat        = "cjs"
  importFileExtension = ""
}

// The connection URL is not configured here. Prisma 7 reads it from
// prisma.config.ts (which reads DATABASE_URL from apps/backend/.env).
datasource db {
  provider = "postgresql"
}

// =============================================================================
// Enums
// =============================================================================

/// Kind of stock movement recorded in the ledger.
///
/// Sign convention for `StockMovement.quantity`:
///   IN, OUT, TRANSFER_IN, TRANSFER_OUT → quantity is always POSITIVE (> 0).
///       The direction comes from the type:
///         IN, TRANSFER_IN   increase stock (+quantity)
///         OUT, TRANSFER_OUT decrease stock (-quantity)
///   ADJUSTMENT → quantity is a SIGNED, non-zero delta:
///         positive = stock found / count higher than recorded
///         negative = stock lost / damaged / count lower than recorded
///
/// Enforced by the `stock_movements_quantity_sign_check` CHECK constraint.
enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT

  @@map("stock_movement_type")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@map("purchase_order_status")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELLED

  @@map("sales_order_status")
}

// =============================================================================
// User management
// =============================================================================

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Store emails normalized (trimmed + lower-cased) in the application layer.
  email        String   @unique @db.VarChar(320)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles                  UserRole[]
  stockMovements         StockMovement[]
  createdPurchaseOrders  PurchaseOrder[]
  createdSalesOrders     SalesOrder[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Machine-readable key, e.g. "products.read" or "purchase-orders.approve".
  key         String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

/// Join table: which roles a user has.
/// Deleting a user or role removes only the assignment rows (Cascade).
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  // The composite PK already indexes userId (leading column); index roleId
  // for "which users have this role" lookups.
  @@index([roleId])
  @@map("user_roles")
}

/// Join table: which permissions a role grants.
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// =============================================================================
// Product management
// =============================================================================

model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
}

/// A product never stores a global stock quantity. Stock is tracked per
/// warehouse in InventoryBalance and audited in the StockMovement ledger.
model Product {
  id            String   @id @default(uuid(7)) @db.Uuid
  sku           String   @unique @db.VarChar(64)
  name          String   @db.VarChar(255)
  description   String?  @db.Text
  /// Optional, but unique when present (PostgreSQL allows many NULLs).
  barcode       String?  @unique @db.VarChar(64)
  categoryId    String?  @map("category_id") @db.Uuid
  /// Free-form unit code, e.g. "pcs", "kg", "l", "box".
  unitOfMeasure String   @map("unit_of_measure") @db.VarChar(32)
  costPrice     Decimal  @map("cost_price") @db.Decimal(19, 4)
  sellingPrice  Decimal  @map("selling_price") @db.Decimal(19, 4)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Deleting a category leaves its products uncategorized.
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  inventoryBalances  InventoryBalance[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems    SalesOrderItem[]

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

// =============================================================================
// Warehouses and inventory
// =============================================================================

model Warehouse {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]

  @@map("warehouses")
}

/// Current on-hand quantity of one product in one warehouse.
///
/// This is a derived/cached value: it must always equal the sum of the
/// signed StockMovement quantities for the same (product, warehouse).
/// Update it in the SAME database transaction that inserts the movement.
model InventoryBalance {
  id          String   @id @default(uuid(7)) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  /// Never negative (CHECK constraint `inventory_balances_quantity_non_negative_check`).
  quantity    Decimal  @default(0) @db.Decimal(18, 3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  // Also serves as the index for lookups by productId (leading column).
  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_balances")
}

/// Append-only ledger of every stock change. Rows are never updated or
/// deleted; corrections are new ADJUSTMENT rows.
/// See StockMovementType for the quantity sign convention.
model StockMovement {
  id                String            @id @default(uuid(7)) @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  warehouseId       String            @map("warehouse_id") @db.Uuid
  type              StockMovementType
  quantity          Decimal           @db.Decimal(18, 3)
  /// Optional id of the source document (purchase order, sales order,
  /// transfer, ...). Not a foreign key because it can point to different
  /// tables. Both rows of a transfer (TRANSFER_OUT + TRANSFER_IN) should share
  /// the same referenceId.
  referenceId       String?           @map("reference_id") @db.Uuid
  notes             String?           @db.Text
  performedByUserId String            @map("performed_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  performedBy User      @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)

  // Product history in a warehouse, newest first / balance recomputation.
  @@index([productId, warehouseId, createdAt])
  // Warehouse activity reports.
  @@index([warehouseId, createdAt])
  @@index([referenceId])
  @@index([performedByUserId])
  @@index([createdAt])
  @@map("stock_movements")
}

// =============================================================================
// Suppliers and purchase orders
// =============================================================================

model Supplier {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(255)
  email     String?  @db.VarChar(320)
  phone     String?  @db.VarChar(50)
  address   String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@map("suppliers")
}

model PurchaseOrder {
  id              String              @id @default(uuid(7)) @db.Uuid
  orderNumber     String              @unique @map("order_number") @db.VarChar(50)
  supplierId      String              @map("supplier_id") @db.Uuid
  status          PurchaseOrderStatus @default(DRAFT)
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User                @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  items     PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@index([createdByUserId])
  @@index([createdAt])
  @@map("purchase_orders")
}

/// Order lines. They belong to their order: deleting an order (e.g. a
/// DRAFT) deletes its lines. Products referenced by lines cannot be deleted.
model PurchaseOrderItem {
  id              String  @id @default(uuid(7)) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  quantity        Decimal @db.Decimal(18, 3)
  unitCost        Decimal @map("unit_cost") @db.Decimal(19, 4)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  // One line per product per order; also indexes purchaseOrderId.
  @@unique([purchaseOrderId, productId])
  @@index([productId])
  @@map("purchase_order_items")
}

// =============================================================================
// Sales orders
// =============================================================================

model SalesOrder {
  id              String           @id @default(uuid(7)) @db.Uuid
  orderNumber     String           @unique @map("order_number") @db.VarChar(50)
  status          SalesOrderStatus @default(DRAFT)
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  items     SalesOrderItem[]

  @@index([status])
  @@index([createdByUserId])
  @@index([createdAt])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String  @id @default(uuid(7)) @db.Uuid
  salesOrderId String  @map("sales_order_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  quantity     Decimal @db.Decimal(18, 3)
  unitPrice    Decimal @map("unit_price") @db.Decimal(19, 4)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([salesOrderId, productId])
  @@index([productId])
  @@map("sales_order_items")
}
